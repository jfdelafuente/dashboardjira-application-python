# Docker Compose Environment Variables
# Copy this file to .env in the same directory as docker-compose.yml
# and customize the values for your environment

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=please-generate-a-random-secret-key-here

# PostgreSQL Database
POSTGRES_DB=support_dashboard
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=strong-password-here-change-me

# Redis Cache
REDIS_PASSWORD=strong-redis-password-here-change-me

# Jira Integration
JIRA_SERVER=https://your-company.atlassian.net
JIRA_EMAIL=your-email@your-company.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=SUP

# Mock Data Mode
# Set to 'false' when using real Jira integration
USE_MOCK_DATA=true

# Logging
LOG_LEVEL=INFO

# Optional: Gunicorn Configuration
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
